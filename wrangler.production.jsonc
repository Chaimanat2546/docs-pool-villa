{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "7c1d945e149fc6fad2124176124d8f33",
  "name": "docs-pool-villa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://rqizfiayvcbozlzuvbok.supabase.co",
    "NEXT_PUBLIC_DOCS_SITE_URL": "https://docs-pool-villa.poolvilla.workers.dev",
    "NEXT_PUBLIC_DOCS_MEDIA_WORKER_URL": "https://docs-media.poolvilla.workers.dev"
  },
  "secrets": {
    "required": ["DOCS_MEDIA_UPLOAD_SECRET", "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"]
  },
  "services": [{ "binding": "DOCS_MEDIA", "service": "docs-media" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
