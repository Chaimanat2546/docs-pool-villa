{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "7c1d945e149fc6fad2124176124d8f33",
  "name": "docs-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://docs-pool-villa.poolvilla.workers.dev",
    "MAX_UPLOAD_BYTES": 10485760
  },
  "secrets": { "required": ["DOCS_MEDIA_UPLOAD_SECRET"] },
  "r2_buckets": [{ "binding": "DOCS_MEDIA_BUCKET", "bucket_name": "webook-media" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
