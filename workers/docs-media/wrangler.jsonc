{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "0df55f166fa309dcc904e992c43f86db",
  "name": "poolvilla-docs-media-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:3000",
    "MAX_UPLOAD_BYTES": 10485760
  },
  "secrets": {
    "required": ["DOCS_MEDIA_UPLOAD_SECRET"]
  },
  "r2_buckets": [
    { "binding": "DOCS_MEDIA_BUCKET", "bucket_name": "poolvilla-docs-media-local" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "staging": {
      "name": "docs-media-staging",
      "secrets": {
        "required": ["DOCS_MEDIA_UPLOAD_SECRET"]
      },
      "vars": {
        "ALLOWED_ORIGIN": "http://localhost:3000,https://docs-pool-villa-staging.chaymanus2003.workers.dev",
        "MAX_UPLOAD_BYTES": 10485760
      },
      "r2_buckets": [
        { "binding": "DOCS_MEDIA_BUCKET", "bucket_name": "docs-media-staging" }
      ]
    }
  }
}
